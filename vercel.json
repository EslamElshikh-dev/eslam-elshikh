{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/blog/pro-guides/", "destination": "/blog/", "permanent": true },
    { "source": "/blog/pro-guides/web-design-riyadh-guide/", "destination": "/blog/professional-website-design-riyadh/", "permanent": true },
    { "source": "/blog/pro-guides/technical-seo-saudi-business/", "destination": "/blog/technical-seo-saudi-businesses/", "permanent": true },
    { "source": "/blog/pro-guides/local-seo-riyadh/", "destination": "/blog/local-seo-riyadh-service-business/", "permanent": true },
    { "source": "/blog/pro-guides/google-business-profile-verification/", "destination": "/blog/google-business-profile-riyadh-guide/", "permanent": true },
    { "source": "/blog/pro-guides/cybersecurity-small-business/", "destination": "/blog/cybersecurity-assessment-small-business/", "permanent": true },
    { "source": "/blog/pro-guides/ai-agents-business/", "destination": "/blog/ai-agents-for-business-saudi/", "permanent": true },
    { "source": "/blog/pro-guides/cloud-solutions-security/", "destination": "/blog/secure-cloud-solutions-guide/", "permanent": true },
    { "source": "/blog/pro-guides/ecommerce-development-saudi/", "destination": "/blog/ecommerce-development-saudi/", "permanent": true },
    { "source": "/blog/pro-guides/landing-pages-conversion/", "destination": "/blog/landing-pages-google-ads/", "permanent": true },
    { "source": "/blog/pro-guides/website-maintenance-security/", "destination": "/blog/website-maintenance-security-seo/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'none'; form-action 'none'; img-src 'self' data: https://www.google-analytics.com; font-src 'self' data:; style-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; manifest-src 'self'; media-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/brand/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
